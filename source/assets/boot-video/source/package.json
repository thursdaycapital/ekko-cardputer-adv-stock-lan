{
  "name": "ekko-user-boot-remotion",
  "version": "1.0.0",
  "description": "The user-provided four-second Ekko Studio opening, reproduced through Remotion for MP4 and Cardputer LCD assets.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/media": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:mp4": "remotion render src/index.ts EkkoOpeningOriginal2K60 renders/ekko-opening-2k60-300k.mp4 --codec=h264 --crf=32 --image-format=png --concurrency=1 --muted --overwrite",
    "render:lcd": "remotion render src/index.ts EkkoOpeningLCD renders/lcd-frames --sequence --image-format=png --concurrency=1"
  }
}
